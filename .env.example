# Worker-Environment (Hetzner)
# Kopiere als .env und befülle. NIEMALS committen.

# Domain für Caddy Auto-SSL (z.B. video-api.herrtechgpt.de)
DOMAIN=

# CORS: Komma-getrennt welche Frontend-Origins dürfen den Worker callen
# z.B. https://app.herrtechgpt.de,http://localhost:3001
ALLOWED_ORIGINS=

# Supabase (exakt gleiche Werte wie in herrtechgpt .env.local)
# https://app.supabase.com → Projekt → Settings → API
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── AI-Provider ──────────────────────────────────────────────────────────────
# Anthropic (Claude) — https://console.anthropic.com
ANTHROPIC_API_KEY=

# OpenAI (Whisper-Transkription) — https://platform.openai.com
OPENAI_API_KEY=

# Fal.ai (Kling/Veo3 Video-Generierung) — https://fal.ai/dashboard/keys
FAL_KEY=

# Google AI (Gemini für Bild-Generierung) — https://aistudio.google.com/apikey
GOOGLE_GENAI_API_KEY=

# ── Optional: Google Cloud Vertex AI (Imagen-Fallback) ───────────────────────
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
# Pfad zu einer Service-Account-JSON (muss ins Container-Volume gemountet sein)
GOOGLE_APPLICATION_CREDENTIALS=
